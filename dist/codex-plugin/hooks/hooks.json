{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|shell|exec_command|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c '/bin/bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/pretooluse-gate.sh\"'",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "^(Bash|shell|exec_command|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c '/bin/bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/careful-guard-codex.sh\"'",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "^(Bash|shell|exec_command|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c '/bin/bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/freeze-guard-codex.sh\"'",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c '/bin/bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/stop-save.sh\"'",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c '/bin/bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
